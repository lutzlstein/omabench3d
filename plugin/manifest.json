{
  "schemaVersion": 1,
  "id": "io.github.lutzlstein.omabench3d",
  "name": "OmaBench3D",
  "version": "0.4.0",
  "author": "Cory Blische",
  "license": "MIT",
  "description": "Run the OmaBench3D UE5 GPU benchmark from a terminal-style panel: pick tests and settings, watch progress, see results and history.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "ui5/OmaBench3DWidget.qml"
  },
  "barWidget": {
    "displayName": "OmaBench3D",
    "description": "Benchmark panel: tests, config, run/abort with progress, results history",
    "category": "Developer Tools",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "tier": "auto",
      "appPath": "auto",
      "tests": "T1",
      "resolution": "native",
      "passes": 1,
      "fullscreen": true,
      "quick": false,
      "monitor": "auto",
      "pixel": "auto",
      "hud": true,
      "theme": "omarchy"
    },
    "schema": [
      {
        "key": "appPath",
        "type": "string",
        "label": "Benchmark launcher",
        "defaultValue": "auto",
        "description": "auto = app installed from the release (~/.local/share/omabench3d/app), else a local Packaged/ build; or a path to OmaBench.sh."
      },
      {
        "key": "tests",
        "type": "string",
        "label": "Tests",
        "defaultValue": "T1",
        "description": "Comma-separated test IDs (T1 for now)."
      },
      {
        "key": "tier",
        "type": "enum",
        "label": "Quality tier",
        "defaultValue": "auto",
        "options": [
          "auto",
          "light",
          "standard",
          "extreme"
        ]
      },
      {
        "key": "resolution",
        "type": "enum",
        "label": "Resolution",
        "defaultValue": "native",
        "options": [
          "native",
          "1920x1080",
          "2560x1440",
          "3840x2160"
        ]
      },
      {
        "key": "monitor",
        "type": "string",
        "label": "Monitor",
        "defaultValue": "auto",
        "description": "Hyprland output name (e.g. DP-3), or auto for the highest refresh rate."
      },
      {
        "key": "passes",
        "type": "integer",
        "label": "Passes",
        "defaultValue": 1,
        "min": 1,
        "max": 5,
        "step": 1
      },
      {
        "key": "fullscreen",
        "type": "boolean",
        "label": "Fullscreen",
        "defaultValue": true
      },
      {
        "key": "quick",
        "type": "boolean",
        "label": "Quick preset",
        "defaultValue": false
      },
      {
        "key": "pixel",
        "type": "enum",
        "label": "Pixel size",
        "defaultValue": "auto",
        "options": [
          "auto",
          "0",
          "2",
          "4",
          "8"
        ],
        "description": "Post-process pixelation (0 = off)."
      },
      {
        "key": "hud",
        "type": "boolean",
        "label": "HUD",
        "defaultValue": true
      },
      {
        "key": "theme",
        "type": "string",
        "label": "Theme",
        "defaultValue": "omarchy",
        "description": "omarchy = match current Omarchy theme, or a preset name (maine-autumn-sunset, hackerman, retro-82, tokyo-night, catppuccin)."
      }
    ]
  },
  "homepage": "https://github.com/lutzlstein/omabench3d"
}
